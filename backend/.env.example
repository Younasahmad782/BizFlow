# Copy to .env and adjust
DATABASE_URL="postgresql://bizflow:bizflow@localhost:5432/bizflow?schema=public"
PORT=4000
JWT_SECRET="change-this-to-a-long-random-string"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bizflow_test?schema=public"
ALLOW_DEV_RESET_TOKENS="true"   # dev only: expose reset tokens in API responses

# AI Business Assistant (optional). When unset, the assistant answers from
# built-in grounded rules using your real data. Never commit real keys.
AI_PROVIDER="openai-compatible"
AI_API_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
