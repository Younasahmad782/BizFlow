# BIZFLOW — environment template.
#
# Copy to .env and fill in REAL values:
#   cp .env.example .env
#
# NEVER commit .env, passwords, JWT secrets, API keys or database credentials.

# --- Database ---
POSTGRES_USER=bizflow
POSTGRES_PASSWORD=change-this-to-a-strong-password
POSTGRES_DB=bizflow
DB_PORT=5432
# Local backend dev (without Docker) connects directly instead of via compose.
# Example: DATABASE_URL=postgresql://bizflow:change-this-to-a-strong-password@localhost:5432/bizflow?schema=public
# DATABASE_URL=
# Test database used by `npm test` (vitest resets it with `prisma db push --force-reset`).
# Example: TEST_DATABASE_URL=postgresql://bizflow:change-this-to-a-strong-password@localhost:5432/bizflow_test?schema=public
# TEST_DATABASE_URL=

# --- Backend ---
NODE_ENV=production
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-32-byte-hex-secret
API_PORT=4000

# Comma-separated browser origins allowed to call the API + sockets.
# Production example: CORS_ORIGIN=https://app.example.com
CORS_ORIGIN=
# Global rate limit: max requests per IP per 15 minutes (auth routes are stricter).
RATE_LIMIT_MAX=600

# --- Password-reset email ---
# console = log a notice without the token (development default)
# none    = disabled, fail-safe (production default)
EMAIL_PROVIDER=none
# Used to build the reset link emailed to users, e.g. https://app.example.com
FRONTEND_URL=
# Exposes the raw reset token in the forgot-password response. TESTS ONLY.
ALLOW_DEV_RESET_TOKENS=false

# --- File uploads ---
# UPLOAD_DIR=/app/uploads is set in docker-compose (persistent volume).
UPLOAD_MAX_MB=10

# --- Frontend ---
WEB_PORT=8080

# --- AI Business Assistant (optional) ---
# When unset, the assistant answers from built-in grounded rules.
# Never commit a real key.
AI_PROVIDER=openai-compatible
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Demo seed data ---
# NEVER enable in production. Intentional local/dev seeding only:
#   SEED_DEMO_DATA=true docker compose exec api npm run prisma:seed
SEED_DEMO_DATA=false
